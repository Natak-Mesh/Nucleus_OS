# Allow natak user to run config_generation.sh as root (needed by mesh-web.service)
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/config_generation.sh

# Allow natak user to run iw-wifi-scan.sh as root (needed by Wi-Fi channel scan)
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/iw-wifi-scan.sh

# Allow natak user to switch eth0 between WAN/LAN modes (needed by ethernet web UI)
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/eth0-mode.sh

# Allow natak user to control cot-bridge service (needed by meshtastic web UI)
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl start cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl disable cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active cot-bridge.service

# Allow natak user to reboot (needed when disabling CoT bridge to release radio BT)
natak ALL=(ALL) NOPASSWD: /usr/sbin/reboot

# Allow natak user to run the node update flow without a password (needed by
# nucleus-update.sh / the web update button). The update script runs the repo's
# install-packages.sh and deploy.sh via sudo; sudo matches by resolved absolute
# path, so these entries use the repo's absolute paths.
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/nucleus-update.sh
natak ALL=(ALL) NOPASSWD: /home/natak/Nucleus_OS/install-packages.sh
natak ALL=(ALL) NOPASSWD: /home/natak/Nucleus_OS/deploy.sh
