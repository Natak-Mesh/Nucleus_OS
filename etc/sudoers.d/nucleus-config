# Allow natak user to run config_generation.sh as root
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/config_generation.sh

# Allow natak user to run iw-wifi-scan.sh as root (Wi-Fi channel scan)
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/iw-wifi-scan.sh

# Allow natak user to control the MAVLink router service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl start mavlink-router.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop mavlink-router.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl restart mavlink-router.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active mavlink-router.service

# Allow natak user to reboot
natak ALL=(ALL) NOPASSWD: /usr/sbin/reboot
