# Allow natak user to run config_generation.sh as root (needed by mesh-web.service)
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/config_generation.sh

# Allow natak user to run iw-wifi-scan.sh as root (needed by Wi-Fi channel scan)
natak ALL=(ALL) NOPASSWD: /opt/nucleus/bin/iw-wifi-scan.sh

# Allow natak user to control cot-bridge service (needed by meshtastic web UI)
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl start cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl stop cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl enable cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl disable cot-bridge.service
natak ALL=(ALL) NOPASSWD: /usr/bin/systemctl is-active cot-bridge.service
